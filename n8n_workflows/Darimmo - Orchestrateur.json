    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let classification;\ntry {\n  const rawText = $json.candidates[0].content.parts[0].text;\n  classification = JSON.parse(rawText);\n} catch (e) {\n  classification = {\n    intent: 'unknown',\n    confidence: 0,\n    entities: {},\n    needs_clarification: true,\n    clarification_question: \"Je n'ai pas bien compris votre demande, pouvez-vous reformuler ?\"\n  };\n}\n\nif (classification.confidence < 0.6) {\n  classification.needs_clarification = true;\n  if (!classification.clarification_question) {\n    classification.clarification_question = \"Pouvez-vous preciser votre demande ?\";\n  }\n}\n\nconst prev = $('Build Classification Prompt').item.json;\n\n// Si clarification necessaire, on route directement vers une reponse,\n// peu importe l'intent detecte.\nconst effectiveIntent = classification.needs_clarification ? 'needs_clarification' : classification.intent;\n\nreturn {\n  json: {\n    session_id: prev.session_id,\n    original_message: prev.original_message,\n    intent: classification.intent,\n    effective_intent: effectiveIntent,\n    confidence: classification.confidence,\n    entities: classification.entities,\n    needs_clarification: classification.needs_clarification,\n    clarification_question: classification.clarification_question,\n    auth_token: prev.auth_token,\n    user_context: prev.user_context\n  }\n};"
      },
