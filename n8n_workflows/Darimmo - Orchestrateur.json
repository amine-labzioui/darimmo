    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Cas : needs_clarification, account_help, general_help, unknown\n// -> reponse directe, sans sous-agent.\nconst d = $json;\n\nlet reply;\nif (d.needs_clarification) {\n  reply = d.clarification_question;\n} else if (d.effective_intent === 'account_help') {\n  reply = \"Pour les questions sur votre compte, je peux vous aider avec vos informations de base. Pouvez-vous preciser votre question ?\";\n} else if (d.effective_intent === 'general_help') {\n  reply = \"Darimmo est une plateforme d'annonces immobilieres au Maroc. Vous pouvez chercher des biens, publier une annonce, ou nous contacter pour plus d'aide. Que souhaitez-vous savoir ?\";\n} else {\n  reply = \"Je n'ai pas compris votre demande. Je peux vous aider a chercher un bien, gerer vos annonces, consulter vos paiements, ou contacter un proprietaire. Pouvez-vous reformuler ?\";\n}\n\nreturn {\n  json: {\n    reply,\n    session_id: d.session_id,\n    recommended_annonce_ids: [],\n    intent: d.intent,\n    metadata: {\n      confidence: d.confidence,\n      entities: d.entities,\n      agent_used: null,\n      tool_calls_count: 0,\n      llm_calls_count: 1\n    }\n  }\n};"
      },
