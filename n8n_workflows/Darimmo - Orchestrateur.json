    {
      "parameters": {
        "jsCode": "const prevData = $('Parse & Apply Rules').item.json;\nconst docsArray = $input.all();\n\nconst seen = new Set();\nconst validDocs = docsArray\n  .map(d => d.json.document?.pageContent || d.json.pageContent || d.json.text || '')\n  .filter(text => text.length > 50)\n  .filter(text => {\n    if (seen.has(text)) return false;\n    seen.add(text);\n    return true;\n  });\n\nconst context = validDocs.join('\\n\\n---\\n\\n');\n\nconst prompt = `Tu es l'assistant general de Darimmo, une plateforme marocaine d'annonces immobilieres.\n\nVoici des articles d'aide pertinents trouves dans la base de connaissances :\n${context || \"Aucun article pertinent trouve.\"}\n\nQuestion de l'utilisateur : \"${prevData.original_message}\"\n\nRegles strictes :\n- Base ta reponse UNIQUEMENT sur les articles fournis ci-dessus. N'invente rien.\n- Si aucun article pertinent n'est trouve, dis-le clairement et propose de contacter le support.\n- Reponds TOUJOURS dans la meme langue que le message de l'utilisateur (francais, darija, arabe standard ou anglais).\n- Reponse claire et concise.`;\n\nreturn {\n  json: {\n    gemini_request_body: { contents: [{ role: \"user\", parts: [{ text: prompt }] }] },\n    session_id: prevData.session_id\n  }\n};"
      },
