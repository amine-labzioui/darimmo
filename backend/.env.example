# ===== Django =====
SECRET_KEY=change-this-secret-key-in-production-use-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.16

# ===== MongoDB =====
MONGO_DB_NAME=darimmo_db
MONGO_CONNECTION_STRING=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/<base>?retryWrites=true&w=majority
# Pour MongoDB Atlas (cloud), utilisez plutôt :
# MONGO_CONNECTION_STRING=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/<base>?retryWrites=true&w=majority

# ===== CORS / Frontend =====
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://local
host:5173,http://localhost:3000

# ===== JWT =====
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ===== Email (notifications) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@darimmo.ma
EMAIL_HOST_PASSWORD=

# ===== N8N Agent IA =====
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ===== Paiements =====
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
CMI_MERCHANT_ID=
CMI_API_KEY=

# ===== Celery / Redis =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
